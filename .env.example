# Copy to .env for local overrides. Every value here is fake.
# In development, kephart/settings/dev.py supplies working defaults, so .env is optional.

DJANGO_SETTINGS_MODULE=kephart.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://kephart:kephart@localhost:5432/kephart
DEFAULT_FROM_EMAIL=Kephart Trail <noreply@example.com>

# Cloudflare Turnstile. These are Cloudflare's always-pass test keys; use real ones in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Production only
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=2592000
